@startuml
left to right direction
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
title Consultation - Database Design Diagram

  class consultations <<Table>> {
    id : UUID <<PK>>
    --
    owner_user_id : UUID
    input_text : TEXT
    photo_local_path : VARCHAR(512)
    photo_storage_key : VARCHAR(255)
    help_requested : BOOLEAN
    created_at : TIMESTAMPTZ
    updated_at : TIMESTAMPTZ
    server_ack_at : TIMESTAMPTZ
  }

  class patients <<Table>> {
    id : UUID <<PK>>
    --
    consultation_id : UUID <<UK, FK>>
    name : VARCHAR(150)
    age_years : INTEGER
    location_description : VARCHAR(255)
    province : VARCHAR(120)
    latitude : DOUBLE
    longitude : DOUBLE
  }

  class consultation_answers <<Table>> {
    id : UUID <<PK>>
    --
    consultation_id : UUID <<UK, FK>>
    guidance_text : TEXT
    guidance_status : VARCHAR(40)
    preliminary_priority : VARCHAR(40)
    professional_help_recommended : BOOLEAN
    source_references : TEXT
    created_at : TIMESTAMPTZ
  }

  class sync_outbox <<Table>> {
    id : UUID <<PK>>
    --
    consultation_id : UUID <<UK, FK>>
    idempotency_key : UUID <<UK>>
    leased_until : TIMESTAMPTZ
    next_attempt_at : TIMESTAMPTZ
    attempt_count : INTEGER
    acked_at : TIMESTAMPTZ
    created_at : TIMESTAMPTZ
}

consultations "1" -- "0..1" patients : consultation_id
consultations "1" -- "0..1" consultation_answers : consultation_id
consultations "1" -- "0..1" sync_outbox : consultation_id

@enduml
